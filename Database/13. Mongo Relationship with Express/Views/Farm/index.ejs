<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products</title>
</head>

<body>

    <h1>
        All Farms
    </h1>
    <ul>
        <% for(let farm of farms){ %>
            <li>
                <a href="/farms/<%= farm._id %>">
                    <%= farm.name %>
                </a>
            </li>
            <% } %>
    </ul>

    <h4>Add a New Farm</h4>
    <a href="/farms/new"><button>Add Farm</button></a>
     
</body>

</html>