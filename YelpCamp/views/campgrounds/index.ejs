<!-- layout('view') is features in 'ejs-mate' when called anywhere inside a template,
  request that the out of the current template be passed to the given view as the "body" local. -->
<div class="conatainer offset-2">
    <% layout('layouts/boilerplate') %>

        <h2>All Campgrounds</h2>

        <a class="btn btn-warning mb-4" href="/campground/new">ADD CAMPGROUND</a>

        <% for(let campground of campgrounds){ %>

            <div class="card mb-2 col-9">
                <div class="row g-0 align-items-center">
                    <div class="col-md-4">
                        <img src="<%= campground.image %>" class="img-fluid rounded-start"
                            style="height: 300px;  object-fit: cover;" alt="<%= campground.title %>">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body p-4">
                            <h5 class="card-title mb-1">
                                <%= campground.title %>
                            </h5>
                            <p class="card-text mb-1">
                                <%= campground.description %>
                            </p>
                            <p class="card-text mb-2"><small class="text-muted">
                                    <%= campground.location %>
                                </small></p>
                            <a class="btn btn-primary btn-sm" href="/campground/<%= campground._id %>">
                                View <%= campground.title %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
</div>