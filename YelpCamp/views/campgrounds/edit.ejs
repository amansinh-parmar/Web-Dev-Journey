<% layout('layouts/boilerplate') %>

    <h4>Edit Campground</h4>
    <form action="/campground/<%= campground._id %>?_method=PUT" method="post">
        <div class="mt-2">
            <label for="title">Title</label>
            <input type="text" name="campground[title]" id="title" value="<%= campground.title %>" required>
        </div>
        <div class="mt-2">
            <label for="location">Location</label>
            <input type="text" name="campground[location]" id="location" value="<%= campground.location  %>">
        </div>
        <a class="btn btn-info mt-2">Update Campground</a>
    </form>
    <a href="/campground">Back to all campground</a>