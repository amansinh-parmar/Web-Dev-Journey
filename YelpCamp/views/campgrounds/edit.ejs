<% layout('layouts/boilerplate') %>

    <div class="row">
        <h1 class="text-center mb-5">Edit Campground</h1>
        <div class="col-5 offset-4">
            <form action="/campground/<%= campground._id %>?_method=PUT" method="post">

                <div class="mb-2">
                    <label class="form-label" for="title">Title</label>
                    <input class="form-control" required type="text" name="campground[title]" id="title"
                        value="<%= campground.title %>">
                </div>

                <div class=" mb-2">
                    <label class="form-label" for="location">Location</label>
                    <input class="form-control" type="text" name="campground[location]" id="location"
                        value="<%= campground.location %>">
                </div>

                <div class=" mb-2">
                    <label class="form-label" for="image">Image URL</label>
                    <input class="form-control" type="text" name="campground[image]" id="image"
                        value="<%= campground.image %>">
                </div>

                <div class="mb-2">
                    <label class="form-label" for="price">Campground Price</label>
                    <div class="input-group">
                        <span class="input-group-text" id="basic-addon1">$</span>
                        <input type="text" class="form-control" id="price" placeholder="0.00" aria-label="price"
                            aria-describedby="basic-addon1" name="campground[price] value=" <%=campground.price %>">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" type="text" name="campground[description]"
                        id="description"><%= campground.description %></textarea>
                </div>

                <div class="mb-2">
                    <button class="btn btn-info">Update Campground</button>
                </div>
                <!-- <a class="btn btn-success mt-4 mb-4" href="/"></a> -->

            </form>
            <a href="/campground">Back to all campground</a>
        </div>
    </div>