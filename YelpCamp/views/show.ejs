<% layout('layouts/boilerplate') %>
    <h1>
        <%= campground.title %>
    </h1>
    <h2>
        <%= campground.location %>
    </h2>

    <img src="<%= campground.image %>" alt="Image of <%= campground.title %>">
    <p>
        <%= campground.description %>
    </p>

    <p>
        <a class="btn btn-secondary" href="/campground/<%= campground._id %>/edit">Edit Campground</a>
    </p>
    <p>
    <form class="btn btn-danger" action="/campground/<%= campground._id %>?_method=DELETE" method="post">Delete
        Campground
    </form>
    </p>
    <footer>
        <a href="/campground">Back to all campgrounds</a>
    </footer>