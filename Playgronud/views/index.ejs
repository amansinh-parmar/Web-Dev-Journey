<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Tasks</title>
    <style>
        ul li a {
            /* list-style: none; */
            color: #000;
            font-size: 1.2rem;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <h1>
        <%= category %> Task
    </h1>
    <ul>
        <% for(let task of tasks){ %>
            <li>
                <a href="/task/<%= task._id %>">
                    <%= task.name %>
                </a>
            </li>
            <% } %>
    </ul>

    <!-- <h4>Add a New Task</h4> -->
    <a href="/task/new"><button>Add Task</button></a>
    <% if(category !=='All' ){ %>
        <a href="/task">All Product</a>
        <% } %>
</body>

</html>