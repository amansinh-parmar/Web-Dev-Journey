<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task</title>
</head>

<body>
    <h1>Edit Task</h1>
    <form action="/task/<%= task._id %>?_method=PUT" method="post">
        <label for="name">Task Name:</label>
        <input type="text" name="name" value="<%= task.name  %>" required>

        <label for="targetDate">Target Date:</label>
        <input type="date" name="targetDate" value="<%= task.targetDate.toISOString().slice(0, 10) %>">

        <label for="category">Task Category:</label>
        <select name="category" required>

            <% for(let category of categories){ %>
                <option value="<%= category %>" <%=task.category===category ? 'selected' : '' %>>
                    <%= category %>
                </option>
                <% } %>
        </select>
        <button>Update</button>
    </form>

    <a href="/task/<%= task._id %>">Cancel</a>

</body>

</html>